<Window x:Class="Spit.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Spit.Core;assembly=Spit.Core"
        Title="{x:Static core:Strings.AppName}"
        Width="900" Height="620"
        MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        FontFamily="{DynamicResource Spit.Font}"
        Background="{DynamicResource Spit.Window}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="184" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- The sidebar names the two things the window is (Mac MainWindow). -->
        <Border Grid.Column="0"
                Background="{DynamicResource Spit.Sidebar}"
                BorderBrush="{DynamicResource Spit.Divider}"
                BorderThickness="0,0,1,0">
            <ListBox x:Name="Nav"
                     Margin="8,12,8,12"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ItemContainerStyle="{DynamicResource Spit.NavItem}"
                     SelectionChanged="OnNavChanged">
                <ListBoxItem x:Name="NavInsights">
                    <StackPanel Orientation="Horizontal">
                        <!-- chart.bar.fill -->
                        <Path Width="14" Height="14" Margin="0,0,10,0" VerticalAlignment="Center" Stretch="Uniform"
                              Fill="{DynamicResource Spit.Text}"
                              Data="M1,9 H4 V15 H1 Z M6.5,5 H9.5 V15 H6.5 Z M12,1 H15 V15 H12 Z" />
                        <TextBlock VerticalAlignment="Center" Text="{x:Static core:Strings.InsightsTitle}" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem x:Name="NavSettings">
                    <StackPanel Orientation="Horizontal">
                        <!-- gear (Segoe Fluent Icons / MDL2 "Setting") -->
                        <TextBlock Width="14" Margin="0,0,10,0" VerticalAlignment="Center"
                                   FontFamily="{DynamicResource Spit.IconFont}" FontSize="14"
                                   Text="&#xE713;" />
                        <TextBlock VerticalAlignment="Center" Text="{x:Static core:Strings.SettingsNav}" />
                    </StackPanel>
                </ListBoxItem>
            </ListBox>
        </Border>

        <ContentControl x:Name="Detail"
                        Grid.Column="1"
                        Focusable="False"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch" />
    </Grid>
</Window>
