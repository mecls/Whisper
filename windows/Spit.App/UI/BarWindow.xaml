<Window x:Class="Spit.App.BarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Spit.Core;assembly=Spit.Core"
        Title="{x:Static core:Strings.AppName}"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Focusable="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{DynamicResource Spit.Font}">
    <!-- The window is exactly its visible content (rule 38): one of the two pills below, nothing around
         it, so it can never swallow a click beyond what the user can see. Nothing is focusable: WPF would
         otherwise call SetFocus on click, which activates even a WS_EX_NOACTIVATE window. -->
    <Grid Focusable="False">
        <!-- Idle: the resting lozenge, 44 × 12, the whole of it the click target. -->
        <Border x:Name="IdlePill"
                Width="44" Height="12"
                CornerRadius="6"
                BorderThickness="1"
                Background="{DynamicResource Spit.BarIdleFill}"
                BorderBrush="{DynamicResource Spit.BarIdleBorder}"
                ToolTip="{x:Static core:Strings.AppName}"
                Focusable="False"
                MouseLeftButtonUp="OnMicClick" />

        <Border x:Name="ActivePill"
                Visibility="Collapsed"
                CornerRadius="16"
                BorderThickness="1"
                Padding="9,5"
                Background="{DynamicResource Spit.BarBackground}"
                BorderBrush="{DynamicResource Spit.BarBorder}"
                Focusable="False">
            <StackPanel Orientation="Horizontal" Focusable="False">
                <!-- The mic button: 22 px circle, 11 px glyph; red with a stop square while latched. -->
                <Border x:Name="MicButton"
                        Width="22" Height="22"
                        CornerRadius="11"
                        VerticalAlignment="Center"
                        Background="{DynamicResource Spit.BarMicFill}"
                        Focusable="False"
                        MouseLeftButtonUp="OnMicClick">
                    <Grid IsHitTestVisible="False">
                        <Viewbox x:Name="MicGlyph" Width="11" Height="11" Stretch="Uniform">
                            <Canvas Width="24" Height="24">
                                <Path x:Name="MicBody"
                                      Fill="{DynamicResource Spit.Text}"
                                      Data="M12,2 C10.07,2 8.5,3.57 8.5,5.5 L8.5,11 C8.5,12.93 10.07,14.5 12,14.5 C13.93,14.5 15.5,12.93 15.5,11 L15.5,5.5 C15.5,3.57 13.93,2 12,2 Z" />
                                <Path x:Name="MicStand"
                                      Stroke="{DynamicResource Spit.Text}"
                                      StrokeThickness="2.2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Data="M5.5,10.5 A6.5,6.5 0 0 0 18.5,10.5 M12,17 L12,21 M8.5,21 L15.5,21" />
                            </Canvas>
                        </Viewbox>
                        <Rectangle x:Name="StopGlyph"
                                   Visibility="Collapsed"
                                   Width="8" Height="8"
                                   RadiusX="1.5" RadiusY="1.5"
                                   Fill="White" />
                    </Grid>
                </Border>

                <!-- Listening: exactly 20 bars, 2.5 wide with a 1.5 gap, at most 16 tall. -->
                <StackPanel x:Name="Waveform"
                            Orientation="Horizontal"
                            Height="16"
                            Margin="7,0,0,0"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False" />

                <!-- Every other state: one line of status, plus live or pasted text when "show text" is on. -->
                <StackPanel x:Name="StatusPanel"
                            Margin="7,0,0,0"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False">
                    <TextBlock x:Name="TitleText"
                               FontSize="10.5"
                               FontWeight="Medium"
                               Typography.NumeralAlignment="Tabular"
                               Foreground="{DynamicResource Spit.Text}" />
                    <TextBlock x:Name="DetailText"
                               Visibility="Collapsed"
                               Margin="0,1,0,0"
                               FontSize="9.5"
                               MaxWidth="220"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Spit.TextSecondary}" />
                </StackPanel>

                <!-- Journey C: the microphone-blocked message carries its way out. -->
                <TextBlock x:Name="OpenSettingsLink"
                           Visibility="Collapsed"
                           Margin="8,0,2,0"
                           VerticalAlignment="Center"
                           FontSize="10.5"
                           TextDecorations="Underline"
                           Cursor="Hand"
                           Text="{x:Static core:Strings.OpenMicrophoneSettings}"
                           Foreground="{DynamicResource Spit.Accent}"
                           MouseLeftButtonUp="OnOpenMicrophoneSettings" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
