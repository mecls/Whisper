<ResourceDictionary x:Class="Spit.App.ThemeDictionary"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light palette as defaults; ThemePalette.Apply swaps these brushes for dark mode, high contrast
         and the user's accent colour, and every consumer reads them through DynamicResource. -->
    <SolidColorBrush x:Key="Spit.Window" Color="#F3F3F3" />
    <SolidColorBrush x:Key="Spit.Sidebar" Color="#EBEBEB" />
    <SolidColorBrush x:Key="Spit.Card" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Spit.CardBorder" Color="#E5E5E5" />
    <SolidColorBrush x:Key="Spit.Text" Color="#1A1A1A" />
    <SolidColorBrush x:Key="Spit.TextSecondary" Color="#5D5D5D" />
    <SolidColorBrush x:Key="Spit.TextTertiary" Color="#8A8A8A" />
    <SolidColorBrush x:Key="Spit.Divider" Color="#E0E0E0" />
    <SolidColorBrush x:Key="Spit.Control" Color="#FBFBFB" />
    <SolidColorBrush x:Key="Spit.ControlBorder" Color="#D0D0D0" />
    <SolidColorBrush x:Key="Spit.Hover" Color="#0F000000" />
    <SolidColorBrush x:Key="Spit.Selection" Color="#1A000000" />
    <SolidColorBrush x:Key="Spit.Notice" Color="#E9E9E9" />
    <SolidColorBrush x:Key="Spit.Placeholder" Color="#E3E3E3" />
    <SolidColorBrush x:Key="Spit.Accent" Color="#005FB8" />
    <SolidColorBrush x:Key="Spit.AccentText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Spit.Danger" Color="#C42B1C" />
    <SolidColorBrush x:Key="Spit.Success" Color="#0F7B0F" />
    <SolidColorBrush x:Key="Spit.Heat0" Color="#26000000" />
    <SolidColorBrush x:Key="Spit.Heat1" Color="#59005FB8" />
    <SolidColorBrush x:Key="Spit.Heat2" Color="#A6005FB8" />
    <SolidColorBrush x:Key="Spit.Heat3" Color="#005FB8" />
    <SolidColorBrush x:Key="Spit.BarBackground" Color="#F2F9F9F9" />
    <SolidColorBrush x:Key="Spit.BarBorder" Color="#1F000000" />
    <SolidColorBrush x:Key="Spit.BarIdleFill" Color="#38808080" />
    <SolidColorBrush x:Key="Spit.BarIdleBorder" Color="#38FFFFFF" />
    <SolidColorBrush x:Key="Spit.BarMicFill" Color="#2E808080" />
    <SolidColorBrush x:Key="Spit.BarLevel" Color="#8A8A8A" />
    <SolidColorBrush x:Key="Spit.Recording" Color="#E6FF3B30" />
    <SolidColorBrush x:Key="Spit.RecordingLevel" Color="#D9FF3B30" />

    <FontFamily x:Key="Spit.Font">Segoe UI</FontFamily>
    <FontFamily x:Key="Spit.IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Text roles -->
    <Style x:Key="Spit.PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Spit.Text}" />
    </Style>
    <Style x:Key="Spit.CardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource Spit.TextSecondary}" />
    </Style>
    <Style x:Key="Spit.Figure" TargetType="TextBlock">
        <Setter Property="FontSize" Value="42" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Foreground" Value="{DynamicResource Spit.Text}" />
    </Style>
    <Style x:Key="Spit.Headline" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        <Setter Property="Foreground" Value="{DynamicResource Spit.Text}" />
    </Style>
    <Style x:Key="Spit.Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource Spit.Text}" />
    </Style>
    <Style x:Key="Spit.Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource Spit.TextSecondary}" />
    </Style>
    <!-- SettingsNote: a wrapping caption with a readable measure (the Mac's idealWidth 420). -->
    <Style x:Key="Spit.Note" TargetType="TextBlock" BasedOn="{StaticResource Spit.Caption}">
        <Setter Property="MaxWidth" Value="420" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style x:Key="Spit.Hint" TargetType="TextBlock" BasedOn="{StaticResource Spit.Caption}">
        <Setter Property="Foreground" Value="{DynamicResource Spit.TextTertiary}" />
    </Style>
    <Style x:Key="Spit.Error" TargetType="TextBlock" BasedOn="{StaticResource Spit.Caption}">
        <Setter Property="Foreground" Value="{DynamicResource Spit.Danger}" />
    </Style>
    <Style x:Key="Spit.FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Spit.Text}" />
    </Style>

    <Style x:Key="Spit.CardBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Spit.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Spit.CardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <!-- Controls. Implicit styles set only what the default templates would otherwise draw unreadably on
         a dark window (CheckBox text), plus a flat button and field look. ComboBox keeps the system
         template, whose own dark-on-light face stays readable in both themes. -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Spit.Text}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource Spit.Control}" />
        <Setter Property="Foreground" Value="{DynamicResource Spit.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Spit.ControlBorder}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Spit.Text}" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="Background" Value="{DynamicResource Spit.Control}" />
        <Setter Property="Foreground" Value="{DynamicResource Spit.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Spit.ControlBorder}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Spit.Text}" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="8,4" />
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="4" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Spit.Accent}" />
        <Setter Property="Background" Value="{DynamicResource Spit.Placeholder}" />
    </Style>

    <Style TargetType="Hyperlink">
        <Setter Property="Foreground" Value="{DynamicResource Spit.Accent}" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Spit.Text}" />
        <Setter Property="Background" Value="{DynamicResource Spit.Control}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Spit.ControlBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" />
                        <Border x:Name="Overlay" Background="Transparent" CornerRadius="4" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Overlay" Property="Background" Value="{DynamicResource Spit.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Overlay" Property="Background" Value="{DynamicResource Spit.Selection}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Spit.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Spit.AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{DynamicResource Spit.AccentText}" />
        <Setter Property="Background" Value="{DynamicResource Spit.Accent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Spit.Accent}" />
    </Style>

    <!-- A borderless icon button (dictionary delete). -->
    <Style x:Key="Spit.IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="FontFamily" Value="{DynamicResource Spit.IconFont}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- The main window's sidebar rows. -->
    <Style x:Key="Spit.NavItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Spit.Text}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Spit.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Spit.Selection}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The Settings pane's tab strip. -->
    <Style x:Key="Spit.Tab" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Spit.Text}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="14,6">
                        <ContentPresenter HorizontalAlignment="Center" RecognizesAccessKey="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Spit.Hover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Spit.Selection}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Spit.Hover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
