<Window x:Class="Spit.App.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Spit.Core;assembly=Spit.Core"
        Title="{x:Static core:Strings.OnboardingTitle}"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="{DynamicResource Spit.Font}"
        Foreground="{DynamicResource Spit.Text}"
        Background="{DynamicResource Spit.Window}">
    <StackPanel Margin="24">
        <TextBlock Style="{DynamicResource Spit.PageTitle}" Margin="0,0,0,16" Text="{x:Static core:Strings.OnboardingTitle}" />

        <!-- Three live rows (rule 40): each a status mark, a line, and the button that fixes it. -->
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="MicMark" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center" />
            <TextBlock x:Name="MicText" Grid.Column="1" Style="{DynamicResource Spit.Body}" VerticalAlignment="Center" />
            <Button x:Name="MicButton" Grid.Column="2" Margin="10,0,0,0" Visibility="Collapsed"
                    Content="{x:Static core:Strings.OpenMicrophoneSettings}" Click="OnOpenMicrophoneSettings" />
        </Grid>

        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="HotkeyMark" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center" />
            <TextBlock x:Name="HotkeyText" Grid.Column="1" Style="{DynamicResource Spit.Body}" VerticalAlignment="Center" />
        </Grid>

        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="TokenMark" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center" />
            <TextBlock x:Name="TokenText" Grid.Column="1" Style="{DynamicResource Spit.Body}" VerticalAlignment="Center" />
            <Button x:Name="TokenButton" Grid.Column="2" Margin="10,0,0,0" Visibility="Collapsed"
                    Content="{x:Static core:Strings.OpenServerSettings}" Click="OnOpenServerSettings" />
        </Grid>

        <Border Height="1" Margin="0,4,0,16" Background="{DynamicResource Spit.Divider}" />

        <Button x:Name="DoneButton"
                HorizontalAlignment="Right"
                MinWidth="80"
                IsEnabled="False"
                Style="{DynamicResource Spit.AccentButton}"
                Content="{x:Static core:Strings.OnboardingDone}"
                Click="OnDone" />
    </StackPanel>
</Window>
