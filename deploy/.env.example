# ─── LLM (Ollama Cloud through its OpenAI-compatible endpoint) ───────────────
# One shared key, kept only here on the VPS; Macs never see it.
LLM_BASE_URL=https://ollama.com/v1
LLM_API_KEY=
# docs/SPIKES.md: gemma4 at `none` cleaned all fixtures in ~0.7 s with no reasoning tokens.
LLM_MODEL=gemma4
LLM_REASONING=none              # none|low|medium|high — gpt-oss needs low (it ignores none)
LLM_CONCURRENCY=5               # Ollama caps in-flight requests per plan; extra requests fail fast
LLM_MAX_TIMEOUT_MS=14000        # ceiling for the per-request budget the Mac sends
LLM_ALLOWED_MODELS=gemma4,gpt-oss:120b,qwen3.5   # comma-separated; PUT /v1/settings.llmModel rejects anything else with 400
# ─── Server ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_TRANSCRIPTS=0               # refused in production

# ─── Infrastructure ──────────────────────────────────────────────────────────
# Name of the existing external Docker network that Traefik listens on. Kept here
# rather than in docker-compose.yml because this repo is public and the compose file
# is committed, while this value is only ever filled in on the box — and because
# deploy/.env is excluded from the rsync in VPS.md §4a, so it survives every deploy.
# Find it with: docker network ls
PROXY_NETWORK=<the-traefik-network>
